{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cloud-drive-manager",
  "version": "0.1.0",
  "identifier": "com.clouddrive.manager",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Cloud Drive Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}